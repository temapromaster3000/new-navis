<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Navisworks loads the plugin assembly itself, so the shipped file is NavisElevation.dll. -->
    <AssemblyName>NavisElevation</AssemblyName>
    <RootNamespace>NavisElevation.Navis</RootNamespace>
    <Description>Navisworks Manage 2021 plugin that reports the elevation of the element under the cursor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Private=false is mandatory: Navisworks resolves these assemblies from its own
      install folder at runtime. Copying them next to the plugin either breaks loading
      or silently pins a second, conflicting copy of the API in the process.
    -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Controls">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The overlay label and the WinForms host control both need WinForms types. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    The Core sources are compiled straight into this assembly instead of being referenced
    as a separate project.

    Reason: Navisworks loads a plug-in assembly itself and does not reliably resolve a
    second assembly sitting beside it, so a two-file deployment can fail to load with no
    error message anywhere. One DLL removes that whole class of failure.

    Consequence: nothing may reference NavisElevation.Core as an assembly from this
    project, or the types would exist twice. Keep Core free of Navisworks references so
    it stays usable on its own — that boundary is what makes the inlining safe.
  -->
  <ItemGroup>
    <!--
      obj\bin are excluded on purpose: the default compile glob only filters the current
      project, so without this the other project's generated AssemblyInfo.cs files land
      here and produce duplicate-attribute errors.
    -->
    <Compile Include="..\NavisElevation.Core\**\*.cs"
             Exclude="..\NavisElevation.Core\obj\**;..\NavisElevation.Core\bin\**"
             LinkBase="Core" />
  </ItemGroup>

</Project>
